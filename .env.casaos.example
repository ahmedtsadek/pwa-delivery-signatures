# CasaOS host port. Change if 8677 is already in use.
APP_PORT=8677

# Persistent data location on CasaOS.
APP_DATA_DIR=/DATA/AppData/pwa-delivery-signatures

# Change both secrets before first start.
POSTGRES_USER=delivery
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=delivery
BOOTSTRAP_KEY=CHANGE_ME_LONG_RANDOM_BOOTSTRAP_KEY

USER_SESSION_HOURS=12
DEVICE_TOKEN_DAYS=180

# Optional approved/self-hosted route services.
ROUTER_BASE_URL=
GEOCODER_BASE_URL=


# Public HTTPS origin used by browser CORS checks.
# Example: https://delivery.example.com
PUBLIC_BASE_URL=
